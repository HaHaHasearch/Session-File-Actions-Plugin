diff --git a/apps/desktop/src/session-file-actions-files.ts b/apps/desktop/src/session-file-actions-files.ts
new file mode 100644
index 0000000000..835a8e5d3c
--- /dev/null
+++ b/apps/desktop/src/session-file-actions-files.ts
@@ -0,0 +1,28 @@
+import { createHash } from "node:crypto";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+export async function copySnapshot(
+  root: string, name: string, bytes: Uint8Array, expectedHash: string, signal: AbortSignal,
+  publish: (uriList: string) => Promise<void>,
+): Promise<void> {
+  if (!name || name === "." || name === ".." || /[<>:"/\\|?*\x00-\x1f]/u.test(name)
+    || /[. ]$/u.test(name) || /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/iu.test(name)) throw new Error("invalid_filename");
+  if (!/^[a-f0-9]{64}$/u.test(expectedHash) || createHash("sha256").update(bytes).digest("hex") !== expectedHash) throw new Error("integrity_failed");
+  signal.throwIfAborted();
+  await mkdir(root, { recursive: true });
+  const directory = await mkdtemp(join(root, "copy-"));
+  let publishing = false;
+  try {
+    const path = join(directory, name);
+    await writeFile(path, bytes, { flag: "wx", signal });
+    if (createHash("sha256").update(await readFile(path, { signal })).digest("hex") !== expectedHash) throw new Error("integrity_failed");
+    signal.throwIfAborted();
+    // A published or uncertain clipboard reference must survive plugin and application exit.
+    publishing = true;
+    await publish(`${pathToFileURL(path).href}\r\n`);
+  } finally {
+    if (!publishing) await rm(directory, { recursive: true });
+  }
+}
diff --git a/apps/desktop/src/session-file-actions.ts b/apps/desktop/src/session-file-actions.ts
new file mode 100644
index 0000000000..fbc4372289
--- /dev/null
+++ b/apps/desktop/src/session-file-actions.ts
@@ -0,0 +1,101 @@
+import { app, ipcMain, clipboard, ClipboardItem, type BrowserWindow, type IpcMainInvokeEvent } from 'electron'
+import { join } from 'node:path'
+import { copySnapshot } from './session-file-actions-files.ts'
+
+import type { CopyDeliveryRequest, CopyDeliveryResult } from './ipc.ts'
+
+/**
+ * Register delivery-copy IPC for the trusted application main frame.
+ * begin supersedes all earlier preparation before Host authorization starts; copy consumes its reservation once.
+ * Cancellation is effective until system publication starts. Published/uncertain snapshots survive application exit.
+ * @param owner - validates the owned main frame on every call and immediately before publication.
+ * @param consume - redeems the one-use Host grant through a fixed private endpoint.
+ */
+export function installSessionFileActions(owner: (event: IpcMainInvokeEvent) => BrowserWindow,
+  consume: (request: CopyDeliveryRequest, signal: AbortSignal) => Promise<Response>): void {
+  let active: { id: string; abort: AbortController; publishing: boolean; started: boolean } | undefined
+  ipcMain.handle('dsh-desktop:delivery-begin', (event, id: unknown) => {
+    owner(event)
+    if (typeof id !== 'string' || !/^[0-9a-f-]{36}$/u.test(id)) throw new Error('invalid_operation')
+    if (active?.publishing) return false
+    active?.abort.abort()
+    active = { id, abort: new AbortController(), publishing: false, started: false }
+    return true
+  })
+  ipcMain.handle('dsh-desktop:delivery-cancel' , (event, id: unknown) => {
+    owner(event)
+    if (active && active.id === id && !active.publishing) active.abort.abort()
+  })
+  ipcMain.handle('dsh-desktop:delivery-copy', async (event, value: unknown): Promise<CopyDeliveryResult> => {
+    const window = owner(event)
+    if (typeof value !== 'object' || value === null
+      || !('token' in value) || typeof value.token !== 'string' || !/^[0-9a-f-]{36}$/u.test(value.token)
+      || !('operationId' in value) || typeof value.operationId !== 'string' || !/^[0-9a-f-]{36}$/u.test(value.operationId)
+      || !('sessionId' in value) || typeof value.sessionId !== 'string' || value.sessionId.length < 1 || value.sessionId.length > 256
+      || !('hostInstanceId' in value) || typeof value.hostInstanceId !== 'string' || !/^[a-f0-9]{64}$/u.test(value.hostInstanceId)) throw new Error('invalid_copy_request')
+    const request = { token: value.token, operationId: value.operationId, sessionId: value.sessionId, hostInstanceId: value.hostInstanceId }
+    const operation = active
+    if (!operation || operation.id !== request.operationId || operation.started || operation.abort.signal.aborted) return { status: 'cancelled', reason: 'superseded' }
+    operation.started = true
+    const signal = AbortSignal.any([operation.abort.signal, AbortSignal.timeout(60_000)])
+    const cancel = (): void => operation.abort.abort()
+    const navigate = (_event: Electron.Event, _url: string, inPlace: boolean, mainFrame: boolean): void => {
+      if (mainFrame && !inPlace) cancel()
+    }
+    window.once('closed', cancel)
+    window.webContents.on('did-start-navigation', navigate)
+    let stage = 'authorize'
+    try {
+      const response = await consume(request, signal)
+      if (!response.ok) {
+        const reason = await response.text()
+        throw new Error(['permission_denied', 'not_found', 'too_large', 'io_error', 'invalid_grant', 'not_regular_file'].includes(reason) ? reason : `host_${response.status}`)
+      }
+      if (response.headers.get('x-copy-host') !== request.hostInstanceId || response.headers.get('x-copy-operation') !== request.operationId) throw new Error('identity_mismatch')
+      const size = Number(response.headers.get('x-copy-size'))
+      const hash = response.headers.get('x-copy-sha256')
+      const encodedName = response.headers.get('x-copy-name')
+      if (size > 32 * 1024 * 1024) throw new Error('too_large')
+      if (!Number.isSafeInteger(size) || size < 0 || !hash || !encodedName || !response.body) throw new Error('invalid_content')
+      stage = 'prepare'
+      const reader = response.body.getReader()
+      const chunks: Uint8Array[] = []
+      let received = 0
+      try {
+        for (;;) {
+          const chunk = await reader.read()
+          if (chunk.done) break
+          received += chunk.value.length
+          if (received > size) throw new Error('size_mismatch')
+          chunks.push(chunk.value)
+        }
+      } finally { await reader.cancel(); reader.releaseLock() }
+      if (received !== size) throw new Error('size_mismatch')
+      await copySnapshot(join(app.getPath('userData'), 'session-file-actions'), decodeURIComponent(encodedName), Buffer.concat(chunks), hash, signal, async uriList => {
+        owner(event)
+        signal.throwIfAborted()
+        if (active !== operation) throw new Error('superseded')
+        operation.publishing = true
+        stage = 'publish'
+        await clipboard.write([new ClipboardItem({ 'text/uri-list': uriList })])
+      })
+      console.info(JSON.stringify({ operationId: request.operationId, host: 'harness', stage: 'published', status: 'copied' }))
+      return { status: 'copied' }
+    } catch (error: unknown) {
+      const status = operation.publishing ? 'unconfirmed' : signal.aborted ? 'cancelled' : 'failed'
+      const code = typeof error === 'object' && error !== null && 'code' in error ? error.code : undefined
+      const errno = typeof code === 'string' && ['ENOSPC', 'EDQUOT', 'EACCES', 'EPERM', 'EIO', 'ENOENT', 'ENOTDIR'].includes(code) ? code : undefined
+      const reason = errno === 'ENOSPC' || errno === 'EDQUOT' ? 'disk_full'
+        : errno === 'EACCES' || errno === 'EPERM' ? 'permission_denied'
+        : errno === 'EIO' ? 'io_error' : errno === 'ENOENT' || errno === 'ENOTDIR' ? 'not_found'
+        : error instanceof Error && /^(host_\d+|identity_mismatch|invalid_content|size_mismatch|invalid_filename|integrity_failed|superseded|permission_denied|not_found|too_large|io_error|invalid_grant|not_regular_file)$/u.test(error.message) ? error.message
+        : stage === 'publish' ? 'publish_failed' : 'copy_failed'
+      console.error(JSON.stringify({ operationId: request.operationId, host: 'harness', stage, status, reason, errno }))
+      return { status, reason }
+    } finally {
+      window.removeListener('closed', cancel)
+      window.webContents.removeListener('did-start-navigation', navigate)
+      if (active === operation) active = undefined
+    }
+  })
+}
diff --git a/apps/desktop/tests/session-file-actions.spec.ts b/apps/desktop/tests/session-file-actions.spec.ts
