+++ b/apps/desktop/tests/session-file-actions.spec.ts
@@ -0,0 +1,112 @@
+import { EventEmitter } from 'node:events'
+import { createHash, randomUUID } from 'node:crypto'
+import { mkdir, mkdtemp, readFile, rm } from 'node:fs/promises'
+import { resolve, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { BrowserWindow } from 'electron'
+import { afterEach, expect, it, vi } from 'vitest'
+import { installSessionFileActions } from '../src/session-file-actions.ts'
+const mocks = vi.hoisted(() => ({ handlers: new Map<string, Function>(), write: vi.fn(), getPath: vi.fn(), mkdirFailure: (() : unknown => undefined)() }))
+vi.mock('node:fs/promises', async importOriginal => {
+  const original = await importOriginal<typeof import('node:fs/promises')>()
+  return { ...original, mkdir: (...args: Parameters<typeof original.mkdir>) => {
+    if (mocks.mkdirFailure) throw mocks.mkdirFailure
+    return original.mkdir(...args)
+  } }
+})
+vi.mock('electron', () => ({
+  BrowserWindow: class extends EventEmitter { webContents = new EventEmitter() },
+  app: { getPath: mocks.getPath }, ipcMain: { handle: (name: string, fn: Function) => mocks.handlers.set(name, fn) },
+  clipboard: { write: mocks.write }, ClipboardItem: class { constructor(readonly data: unknown) {} },
+}))
+const roots: string[] = []
+afterEach(async () => { vi.clearAllMocks(); mocks.mkdirFailure = undefined; mocks.handlers.clear(); for (const root of roots.splice(0)) await rm(root, { recursive: true }); })
+async function fixture() {
+  const base = resolve('.local/tmp/copy-tests'); await mkdir(base, { recursive: true });
+  const root = await mkdtemp(join(base, 'test-')); roots.push(root); mocks.getPath.mockReturnValue(root);
+  const owner = vi.fn(() => new BrowserWindow());
+  const request = { token: randomUUID(), operationId: randomUUID(), sessionId: 'session', hostInstanceId: 'a'.repeat(64) };
+  const data = new Uint8Array([0, 255, 17]);
+  const consume = vi.fn(async () => new Response(data, { headers: {
+    'x-copy-host': request.hostInstanceId, 'x-copy-operation': request.operationId, 'x-copy-name': 'binary.bin',
+    'x-copy-size': '3', 'x-copy-sha256': createHash('sha256').update(data).digest('hex'),
+  } }));
+  installSessionFileActions(owner, consume);
+  const begin = (id = request.operationId): Promise<unknown> => {
+    const handler = mocks.handlers.get('dsh-desktop:delivery-begin'); if (!handler) throw new Error('missing begin');
+    return Promise.resolve(Reflect.apply(handler, undefined, [{}, id]));
+  };
+  const invoke = async (value: unknown = request, accept = true): Promise<unknown> => {
+    if (accept) await begin();
+    const handler = mocks.handlers.get('dsh-desktop:delivery-copy'); if (!handler) throw new Error('missing handler');
+    return Reflect.apply(handler, undefined, [{}, value]);
+  };
+  return { invoke, begin, owner, consume, request };
+}
+it('publishes only the checked snapshot and waits for the system reply', async () => {
+  const { invoke } = await fixture();
+  const complete = Promise.withResolvers<void>(); mocks.write.mockReturnValue(complete.promise);
+  const operation = invoke(); let done = false; void operation.then(() => { done = true });
+  await vi.waitFor(() => expect(mocks.write).toHaveBeenCalledOnce()); expect(done).toBe(false);
+  const item: unknown = mocks.write.mock.calls[0]?.[0]?.[0];
+  if (typeof item !== 'object' || item === null || !('data' in item) || typeof item.data !== 'object' || item.data === null || !('text/uri-list' in item.data) || typeof item.data['text/uri-list'] !== 'string') throw new Error('missing uri list');
+  expect([...await readFile(fileURLToPath(item.data['text/uri-list'].trim()))]).toEqual([0, 255, 17]);
+  complete.resolve(); expect(await operation).toEqual({ status: 'copied' });
+});
+it('rejects an untrusted sender and arbitrary renderer path without consuming credentials', async () => {
+  const { invoke, owner, consume } = await fixture();
+  owner.mockImplementationOnce(() => { throw new Error('untrusted') });
+  await expect(invoke()).rejects.toThrow('untrusted');
+  await expect(invoke({ path: 'private' })).rejects.toThrow('invalid_copy_request');
+  expect(consume).not.toHaveBeenCalled(); expect(mocks.write).not.toHaveBeenCalled();
+});
+it('keeps the clipboard on failed Host authorization or incorrect identity', async () => {
+  const { invoke, consume } = await fixture();
+  consume.mockResolvedValueOnce(new Response('denied', { status: 403 }));
+  expect(await invoke()).toEqual({ status: 'failed', reason: 'host_403' });
+  consume.mockResolvedValueOnce(new Response('bytes'));
+  expect(await invoke()).toEqual({ status: 'failed', reason: 'identity_mismatch' });
+  expect(mocks.write).not.toHaveBeenCalled();
+});
+it('reports an uncertain system publication without claiming success', async () => {
+  const { invoke } = await fixture(); mocks.write.mockRejectedValueOnce(new Error('system unknown'));
+  expect(await invoke()).toEqual({ status: 'unconfirmed', reason: 'publish_failed' });
+});
+
+it.each([['ENOSPC', 'disk_full'], ['EACCES', 'permission_denied'], ['EIO', 'io_error']])('preserves safe %s diagnostics and never publishes', async (code, reason) => {
+  const { invoke } = await fixture();
+  mocks.mkdirFailure = Object.assign(new Error('private/path'), { code });
+  const logged = vi.spyOn(console, 'error').mockImplementation(() => {});
+  try {
+    expect(await invoke()).toEqual({ status: 'failed', reason });
+    expect(mocks.write).not.toHaveBeenCalled();
+    expect(JSON.stringify(logged.mock.calls)).toContain(code);
+    expect(JSON.stringify(logged.mock.calls)).not.toContain('private/path');
+  } finally { logged.mockRestore(); }
+});
+it('revokes A as soon as B begins, without requiring a B grant', async () => {
+  const { invoke, begin, consume } = await fixture();
+  const response = Promise.withResolvers<Response>(); consume.mockReturnValueOnce(response.promise);
+  const a = invoke(); await vi.waitFor(() => expect(consume).toHaveBeenCalledOnce());
+  await begin(randomUUID()); response.resolve(new Response('denied', { status: 403 }));
+  expect(await a).toMatchObject({ status: 'cancelled' }); expect(mocks.write).not.toHaveBeenCalled();
+});
+it('rejects a delayed A grant after B begins before reading the Host', async () => {
+  const { invoke, begin, consume } = await fixture();
+  await begin(); await begin(randomUUID());
+  expect(await invoke(undefined, false)).toEqual({ status: 'cancelled', reason: 'superseded' });
+  expect(consume).not.toHaveBeenCalled(); expect(mocks.write).not.toHaveBeenCalled();
+});
+it('reports Host too_large distinctly without clipboard publication', async () => {
+  const { invoke, consume } = await fixture(); consume.mockResolvedValueOnce(new Response('too_large', { status: 413 }));
+  expect(await invoke()).toEqual({ status: 'failed', reason: 'too_large' }); expect(mocks.write).not.toHaveBeenCalled();
+});
+
+it.each(['copied', 'unconfirmed'])('rejects B as busy while preserving A %s publication receipt', async status => {
+  const { invoke, begin } = await fixture(); const receipt = Promise.withResolvers<void>();
+  mocks.write.mockReturnValueOnce(receipt.promise);
+  const a = invoke(); await vi.waitFor(() => expect(mocks.write).toHaveBeenCalledOnce());
+  expect(await begin(randomUUID())).toBe(false);
+  if (status === 'copied') receipt.resolve(); else receipt.reject(new Error('system unknown'));
+  expect(await a).toMatchObject({ status }); expect(mocks.write).toHaveBeenCalledOnce();
+});
