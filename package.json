{
  "name": "session-file-actions",
  "private": true,
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify.ps1",
    "host:opencode": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/host-build.ps1",
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  }
}
